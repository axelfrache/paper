# Core
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
# DATABASE_URL is set by docker-compose; uncomment for a standalone backend run.
# DATABASE_URL=postgres://paper:paper@localhost:5432/paper?sslmode=disable

# Authentication provider: "dev" (no login, single local user), "local"
# (email/password stored in Postgres), or "oidc" (external identity provider).
AUTH_PROVIDER=dev
# Required for "local" and "oidc". Generate a strong value with:
#   openssl rand -hex 32
# In "dev" mode a built-in default is used when left empty.
AUTH_SESSION_SECRET=
AUTH_PUBLIC_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_REGISTRATION_ENABLED=true

# "dev" provider identity.
AUTH_DEV_USER_ID=dev-user
AUTH_DEV_EMAIL=developer@paper.local
AUTH_DEV_NAME=Local developer
AUTH_DEV_ROLES=paper-admin
AUTH_LEGACY_OWNER_ID=dev-user

# "local" provider: seed an admin account on startup (idempotent).
# AUTH_LOCAL_ADMIN_EMAIL=admin@example.com
# AUTH_LOCAL_ADMIN_PASSWORD=
# AUTH_LOCAL_ADMIN_NAME=Administrator

# "oidc" provider (for example Keycloak).
# OIDC_ISSUER_URL=https://your-keycloak.example.com/realms/paper
# OIDC_CLIENT_ID=paper
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=http://localhost:5173/api/auth/callback

# Image storage: "filesystem" (default, on disk) or "s3" (S3-compatible bucket).
STORAGE_PROVIDER=filesystem
FILESYSTEM_STORAGE_PATH=/var/lib/paper/uploads

# S3 mode only. Start with: docker compose -f docker-compose.yml -f docker-compose.s3.yml up
# That override ships working defaults for a local trial. Set your own bucket and
# generate your own credentials for anything real.
# S3_ENDPOINT=http://garage:3900
# S3_BUCKET=paper-images
# S3_REGION=garage
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# GARAGE_RPC_SECRET=
# GARAGE_ACCESS_KEY_ID=
# GARAGE_SECRET_ACCESS_KEY=
# GARAGE_PORT=3902

# AI is optional and OFF by default: leave AI_PROVIDER empty and the AI actions
# are hidden. Set a provider below to enable them.
AI_PROVIDER=
# Must exceed the provider's own budget: a gateway walking a model fallback chain
# can spend a multiple of any single model's timeout before it answers.
AI_TIMEOUT_SECONDS=120

# Self-contained local AI with Ollama:
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434
# AI_MODEL=llama3.1

# Generic OpenAI-compatible endpoint:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_MODEL=llama3.1

# Gateway with provider fallback:
# AI_PROVIDER=ai-gateway
# AI_BASE_URL=http://localhost:8081
# AI_API_KEY=
# AI_MODEL=ai-gateway:json
