PORT=8080
ALLOWED_ORIGINS=http://localhost:5173

# Recommended: route through ai-gateway for provider fallback.
AI_PROVIDER=ai-gateway
AI_BASE_URL=http://localhost:8081
AI_API_KEY=
AI_MODEL=ai-gateway:json

# Direct local Ollama example:
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434
# AI_MODEL=llama3.1

# Generic OpenAI-compatible example:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_MODEL=llama3.1
